  "packOk": [
    {
      "name": "a full pack with every optional field parses",
      "base": "en",
      "set": {
        "script": "cjk",
        "recognition": [
          {
            "id": "r1",
            "pattern": "\\bfoo\\b",
            "template": "bar",
            "atClauseStart": true,
            "context": "baz"
          }
        ],
        "beforeTranslation": [
          {
            "id": "b1",
            "pattern": "x",
            "template": "y"
          }
        ],
        "terms": [
          {
            "id": "t1",
            "text": "Tuan",
            "variants": [
              "Tuấn",
              "Toan"
            ],
            "fixed": {
              "en": "Tuan"
            },
            "origin": "user"
          }
        ],
        "hints": [
          "a",
          "b"
        ]
      },
      "expect": {
        "script": "cjk",
        "recognitionCount": 1,
        "atClauseStart": true,
        "termOrigin": "user",
        "hints": [
          "a",
          "b"
        ]
      }
    },
    {
      "name": "optional lists and minConfidence may be absent",
      "base": "en",
      "remove": [
        "recognition",
        "beforeTranslation",
        "terms",
        "hints",
        "minConfidence"
      ],
      "expect": {
        "minConfidence": null,
        "recognitionCount": 0
      }
    },
    {
      "name": "a term without origin is a user term",
      "base": "en",
      "set": {
        "terms": [
          {
            "id": "t",
            "text": "x"
          }
        ]
      },
      "expect": {
        "termOrigin": "user"
      }
    }
  ],
  "packErrors": [
    {
      "name": "missing label",
      "base": "en",
      "remove": [
        "label"
      ],
      "field": "label"
    },
    {
      "name": "label of the wrong type",
      "base": "en",
      "set": {
        "label": 3
      },
      "field": "label"
    },
    {
      "name": "invalid recognition pattern",
      "base": "en",
      "set": {
        "recognition": [
          {
            "id": "r",
            "pattern": "(",
            "template": "x"
          }
        ]
      },
      "field": "recognition[0].pattern"
    },
    {
      "name": "invalid beforeTranslation context",
      "base": "en",
      "set": {
        "beforeTranslation": [
          {
            "id": "a",
            "pattern": "a",
            "template": "b"
          },
          {
            "id": "r",
            "pattern": "a",
            "template": "b",
            "context": "["
          }
        ]
      },
      "field": "beforeTranslation[1].context"
    },
    {
      "name": "unknown script",
      "base": "en",
      "set": {
        "script": "klingon"
      },
      "field": "script"
    },
    {
      "name": "rule missing its template",
      "base": "en",
      "set": {
        "recognition": [
          {
            "id": "r",
            "pattern": "a"
          }
        ]
      },
      "field": "recognition[0].template"
    },
    {
      "name": "term with an unknown origin",
      "base": "en",
      "set": {
        "terms": [
          {
            "id": "t",
            "text": "x",
            "origin": "robot"
          }
        ]
      },
      "field": "terms[0].origin"
    },
    {
      "name": "term fixed value not a string",
      "base": "en",
      "set": {
        "terms": [
          {
            "id": "t",
            "text": "x",
            "fixed": {
              "en": 1
            }
          }
        ]
      },
      "field": "terms[0].fixed"
    },
    {
      "name": "hints entry not a string",
      "base": "en",
      "set": {
        "hints": [
          "a",
          1
        ]
      },
      "field": "hints"
    },
    {
      "name": "recognition entry not an object",
      "base": "en",
      "set": {
        "recognition": [
          "x"
        ]
      },
      "field": "recognition[0]"
    }
  ],

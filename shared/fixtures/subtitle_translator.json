{
  "description": "SubtitleTranslator (app/lib/core/subtitle_translator.dart). The fake translator records every request, waits delayMs, then throws for texts in `failing` or returns the text upper-cased. Steps run in order; consecutive non-wait steps are one synchronous burst.",
  "scenarios": [
    {
      "name": "finals are translated once and joined",
      "translator": {
        "delayMs": 5
      },
      "steps": [
        {
          "op": "partial",
          "turn": 1,
          "text": "xin"
        },
        {
          "op": "partial",
          "turn": 1,
          "text": "xin chào"
        },
        {
          "op": "final",
          "turn": 1,
          "text": "xin chào"
        },
        {
          "op": "partial",
          "turn": 1,
          "text": ""
        },
        {
          "op": "partial",
          "turn": 1,
          "text": "anh"
        },
        {
          "op": "final",
          "turn": 1,
          "text": "anh khỏe không"
        },
        {
          "op": "partial",
          "turn": 1,
          "text": ""
        },
        {
          "op": "wait",
          "ms": 200
        }
      ],
      "expect": {
        "results": {
          "1": "XIN CHÀO ANH KHỎE KHÔNG"
        },
        "requestCounts": [
          {
            "text": "xin chào",
            "max": 2
          },
          {
            "text": "anh khỏe không",
            "exactly": 1
          }
        ]
      }
    },
    {
      "name": "late final of an earlier turn lands in that turn",
      "translator": {
        "delayMs": 50
      },
      "steps": [
        {
          "op": "final",
          "turn": 1,
          "text": "một"
        },
        {
          "op": "final",
          "turn": 1,
          "text": "hai"
        },
        {
          "op": "partial",
          "turn": 2,
          "text": "ba"
        },
        {
          "op": "wait",
          "ms": 400
        }
      ],
      "expect": {
        "results": {
          "1": "MỘT HAI",
          "2": "BA"
        }
      }
    },
    {
      "name": "a failed translation keeps the volatile translation",

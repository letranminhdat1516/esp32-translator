#!/bin/bash
# cb — start Claude Code inside tmux so the claude-board daemon can type voice commands into it.
#   cb [claude arguments...]
# Outside tmux: runs `claude "$@"` in a tmux session named after the current directory, or attaches to that
# session if it already exists (the arguments are then not used). Inside tmux: runs claude in the current pane.
# Either way the pane gets the option @claude_board=1: the daemon only types into marked panes that still run
# the session's own Claude Code. Remote Control and everything else work as usual.
# Test hooks: CB_TMUX (tmux binary), CB_NO_ATTACH=1 (print the pane id instead of attaching)
set -euo pipefail

TMUX_BIN=${CB_TMUX:-$(command -v tmux || true)}
for candidate in /opt/homebrew/bin/tmux /usr/local/bin/tmux; do
  if [ -z "$TMUX_BIN" ] && [ -x "$candidate" ]; then TMUX_BIN=$candidate; fi
done
[ -n "$TMUX_BIN" ] || { echo "cb: tmux not found (brew install tmux)" >&2; exit 1; }
CLAUDE_BIN=$(command -v claude || true)
[ -n "$CLAUDE_BIN" ] || { echo "cb: claude not found in PATH" >&2; exit 1; }

if [ -n "${TMUX:-}" ]; then
  [ -n "${TMUX_PANE:-}" ] || { echo "cb: \$TMUX is set but \$TMUX_PANE is not; cannot tell which pane to mark" >&2; exit 1; }
  if "$TMUX_BIN" set-option -p -t "$TMUX_PANE" @claude_board 1; then
    # claude is exec'd (the chain must stay shell -> claude), so a detached watcher clears the mark once this
    # pid (which becomes claude) is gone. It has no terminal: 0-2 are /dev/null and every inherited descriptor
    # above 2 (a terminal the caller left open…) is closed, so the daemon never sees it holding the pane's tty.
    (
      for fd in /dev/fd/*; do
        fd=${fd##*/}
        if [ "$fd" -gt 2 ] 2>/dev/null; then eval "exec $fd>&-"; fi
      done
      while kill -0 "$$" 2>/dev/null; do sleep 2; done
      "$TMUX_BIN" set-option -p -u -t "$TMUX_PANE" @claude_board
    ) </dev/null >/dev/null 2>&1 &
  else
    echo "cb: could not mark this pane; voice commands disabled for this pane" >&2
  fi
  exec "$CLAUDE_BIN" "$@"
fi

# Session name: sanitised directory name (tmux rejects "." and ":") plus a hash of the full path, so
# different directories never share a session.
base=$(printf '%s' "$(basename "$PWD")" | LC_ALL=C tr -c 'A-Za-z0-9_-' '_')
[ -n "$base" ] || base=claude
name="$base-$(printf '%06x' "$(printf '%s' "$PWD" | cksum | cut -d' ' -f1)" | tail -c 6)"
if "$TMUX_BIN" has-session -t "=$name" 2>/dev/null; then
  pane=$("$TMUX_BIN" display-message -p -t "=$name:" '#{pane_id}')
  mark=$("$TMUX_BIN" display-message -p -t "=$name:" '#{@claude_board}')
  if [ "$mark" != 1 ]; then
    echo "cb: tmux session $name exists but isn't a cb session; not attaching" >&2
    exit 1
  fi
  [ $# -eq 0 ] || echo "cb: session already running; arguments ignored" >&2
else
  # The pane command marks its own pane before it execs claude, so claude never runs unmarked and the
  # pane process is claude itself.
  pane=$("$TMUX_BIN" new-session -d -P -F '#{pane_id}' -s "$name" -c "$PWD" -e "PATH=$PATH" -- \
    sh -c 'tmux=$1; claude=$2; shift 2; "$tmux" set-option -p -t "$TMUX_PANE" @claude_board 1; exec "$claude" "$@"' \
    cb "$TMUX_BIN" "$CLAUDE_BIN" "$@")
fi
if [ "${CB_NO_ATTACH:-0}" = 1 ]; then
  echo "$pane"
  exit 0
fi
exec "$TMUX_BIN" attach-session -t "=$name"

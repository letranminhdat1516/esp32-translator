CONFIG_IDF_TARGET="esp32s3"

# Flash 32MB, PSRAM octal 8MB (read via esptool / boot log)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# BLE peripheral (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Peripheral only: the board never scans, initiates a connection or acts as a GATT client
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# Two links: the iPhone can reconnect while its previous link has not timed out yet
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="ESP-Translator"
# Pairing by code: LE Secure Connections only (no legacy pairing, 16-byte keys); ble_link.c sets sm_sc_only too
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
# Host task stack: the text handler takes the LVGL lock and lays out subtitles
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144

# Persisted subscriptions (CCCDs) across bonds (audio, control), with room for re-pairs
CONFIG_BT_NIMBLE_MAX_CCCDS=16

# Keep the console readable: NimBLE logs every notification at INFO
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Power: CPU frequency scaling + BLE modem sleep between connection events
CONFIG_PM_ENABLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# font_store.c loads the script fonts from the mapped 'fonts' partition through LVGL's memory file system
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
# ...and its glyph tables (a few hundred KB) need more than LVGL's 64 KB builtin pool: lv_malloc = malloc (PSRAM-backed)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
